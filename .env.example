# ── Email notifications (contact / book / referral forms) ──────────────────
# Preferred: Resend (https://resend.com) — free tier is enough for this site.
# 1. Create an API key at https://resend.com/api-keys
# 2. For production, verify your domain and set RESEND_FROM to that domain
#    e.g. "Chameleon Care Group <enquiries@chameleoncaregroup.com.au>"
# Without RESEND_API_KEY the site falls back to FormSubmit (free, no key).
# FormSubmit emails the public inbox; activate via the first confirmation email.
RESEND_API_KEY=
# Display name "Chameleon" — requires verified domain in Resend
RESEND_FROM=Chameleon <enquiries@chameleoncaregroup.com.au>
# NOTIFY_EMAILS=enquiries@chameleoncaregroup.com.au,chameleonnursingcare@gmail.com


# Optional — comma-separated staff inboxes (defaults to chameleonnursingcare@gmail.com)
# NOTIFY_EMAILS=chameleonnursingcare@gmail.com,hello@techaidaustralia.com.au

# Set to true to disable the FormSubmit fallback (Resend-only)
# DISABLE_FORMSUBMIT_FALLBACK=false
